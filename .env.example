# Token from @BotFather
BOT_TOKEN=

# Telegram user_id of the aggregator owner (you). Multiple admins comma-separated.
OWNER_USER_ID=

# Channel-aggregator where matched posts are republished.
# Either a numeric chat_id (preferred, e.g. -1001234567890) or @username.
AGGREGATOR_CHANNEL_ID=

# Trigger emoji that clients place in their post to mark it for reposting.
TRIGGER_EMOJI=🤑

# Subscription price in Telegram Stars per 30 days.
PRICE_STARS_30D=500

# PostgreSQL connection string.
# Format: postgres://user:password@host:port/dbname  (sslmode=require is supported)
DATABASE_URL=
